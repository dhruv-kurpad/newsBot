# Gmail — run: python gmail_auth.py  (creates token.json from credentials.json)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_LABEL=Newsletters
# Only needed for service-account domain-wide delegation (optional)
GMAIL_USER=

# Local LLM (Ollama / LM Studio)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2

# Embeddings / vector store
EMBEDDING_MODEL=nomic-embed-text
VECTOR_STORE_PATH=./data/chroma
# Drop Chroma summaries older than this many days on each digest run
RETENTION_DAYS=5

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scheduler
TIMEZONE=America/Los_Angeles
DIGEST_HOUR=8
DIGEST_MINUTE=30
